---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ScannerInput from '../components/ScannerInput.astro';
import ScannerResult from '../components/ScannerResult.astro';


const modules = [
  {
    id: 'feedback',
    label: 'Feedback',
    path: '/feedback',
    description: 'Help us to Improve your Experience',
    iconBg: 'var(--cyan-soft)',
    iconColor: 'var(--cyan)',
    svg: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`
  },
  {
    id: 'learn',
    label: 'Fraud Learning Center',
    path: '/learn',
    description: 'Learn about scams',
    iconBg: 'var(--cyan-soft)',
    iconColor: 'var(--cyan)',
    svg: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>`
  },
  {
    id: 'emergency',
    label: 'Emergency Center',
    path: '/emergency',
    description: 'Fraud response',
    iconBg: 'var(--error-soft)',
    iconColor: 'var(--error)',
    svg: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>`
  },
  {
    id: 'community',
    label: 'Community Registry',
    path: '/community',
    description: 'Search & report scammers',
    iconBg: 'var(--violet-soft)',
    iconColor: 'var(--violet)',
    svg: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`
  },
  {
    id: 'blogs',
    label: 'Awareness Blogs',
    path: '/blogs',
    description: 'Community scam stories & tips',
    iconBg: 'var(--warning-soft)',
    iconColor: 'var(--warning-deep)',
    svg: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>`
  },
];
---

<Layout title="SAFE - Scan & Verify" currentPage="scan">
  <main class="main-home">
    <!-- Google tag (gtag.js) -->
   

    <!-- 1. Compact Hero Intro (Top) -->
    <Hero />

    <!-- 2. Scanner (Now at the top, wider) -->
    <ScannerInput />

    <!-- 3. Scanner Result -->
    <ScannerResult />

    <!-- 4. Trust Stats Bar (moved below scanner for better flow) -->
    <section class="trust-strip">
    <div class="trust-strip-inner">
      <div class="trust-divider"></div>
        <div class="trust-item">
          <span class="trust-value">&lt;1s</span>
          <span class="trust-label">Scan Time</span>
        </div>
        <div class="trust-divider"></div>
        <div class="trust-item">
          <span class="trust-value">24/7</span>
          <span class="trust-label">Protection</span>
        </div>
    </div>
    </section>


<section class="modules-section">
  <div class="container">
    <div class="modules-header">
      <div class="modules-header-text">
        <span class="modules-badge">Explore</span>
        <h2 class="modules-title">All Modules</h2>
        <p class="modules-desc">Everything you need to stay safe online</p>
      </div>
      <div class="modules-nav" id="modulesNav">
        <button class="nav-arrow nav-arrow-prev" id="prevBtn" aria-label="Previous">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <button class="nav-arrow nav-arrow-next" id="nextBtn" aria-label="Next">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
      </div>
    </div>

    <div class="modules-scroll-wrapper">
      <div class="modules-grid" id="modulesGrid">
        {modules.map((module) => (
          <a href={module.path} class="module-card">
            <div class="module-card-inner">
              <!-- Injecting the SVG string directly into the div -->
              <div 
                class="module-icon" 
                style={`--icon-bg: ${module.iconBg}; --icon-color: ${module.iconColor};`}
                set:html={module.svg}
              ></div>
              
              <div class="module-content">
                <span class="module-name">{module.label}</span>
                <span class="module-desc">{module.description}</span>
              </div>
              
              <div class="module-arrow">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"/>
                  <polyline points="12 5 19 12 12 19"/>
                </svg>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>

    <div class="modules-dots" id="modulesDots"></div>
  </div>
</section>
  </main>

  <!-- Floating Write Blog Button (above AI chat bubble) -->
  <a href="/submit-blog" class="write-fab" id="writeFab" aria-label="Write a Blog">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 20h9"/>
      <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
    </svg>
    <span class="fab-label">Write a Blog</span>
  </a>

</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const grid = document.getElementById('modulesGrid');
    const prevBtn = document.getElementById('prevBtn');
    const nextBtn = document.getElementById('nextBtn');
    const dotsContainer = document.getElementById('modulesDots');
    const nav = document.getElementById('modulesNav');

    if (!grid || !prevBtn || !nextBtn) return;

    let scrollAmount = 0;
    const cardWidth = 280;
    const gap = 16;
    const step = cardWidth + gap;

    function getMaxScroll() {
      return Math.max(0, grid.scrollWidth - grid.clientWidth);
    }

    function updateArrows() {
      const maxScroll = getMaxScroll();
      prevBtn.disabled = scrollAmount <= 0;
      nextBtn.disabled = scrollAmount >= maxScroll - 5;
      prevBtn.classList.toggle('disabled', prevBtn.disabled);
      nextBtn.classList.toggle('disabled', nextBtn.disabled);
    }

    function updateDots() {
      const totalDots = Math.ceil(getMaxScroll() / step) + 1;
      const activeIndex = Math.round(scrollAmount / step);
      dotsContainer.innerHTML = '';
      for (let i = 0; i < totalDots; i++) {
        const dot = document.createElement('button');
        dot.className = `dot ${i === activeIndex ? 'active' : ''}`;
        dot.setAttribute('aria-label', `Go to slide ${i + 1}`);
        dot.addEventListener('click', () => {
          scrollAmount = i * step;
          grid.scrollTo({ left: scrollAmount, behavior: 'smooth' });
          updateArrows();
          updateDots();
        });
        dotsContainer.appendChild(dot);
      }
    }

    prevBtn.addEventListener('click', () => {
      scrollAmount = Math.max(0, scrollAmount - step);
      grid.scrollTo({ left: scrollAmount, behavior: 'smooth' });
      updateArrows();
      setTimeout(updateDots, 300);
    });

    nextBtn.addEventListener('click', () => {
      scrollAmount = Math.min(getMaxScroll(), scrollAmount + step);
      grid.scrollTo({ left: scrollAmount, behavior: 'smooth' });
      updateArrows();
      setTimeout(updateDots, 300);
    });

    grid.addEventListener('scroll', () => {
      scrollAmount = grid.scrollLeft;
      updateArrows();
      clearTimeout(window.dotTimeout);
      window.dotTimeout = setTimeout(updateDots, 100);
    });

    function checkMobile() {
      const isMobile = window.innerWidth < 768;
      nav.style.display = isMobile ? 'flex' : 'none';
      dotsContainer.style.display = isMobile ? 'flex' : 'none';
      if (isMobile) {
        updateArrows();
        updateDots();
      }
    }

    checkMobile();
    window.addEventListener('resize', checkMobile);
  });
</script>

<style is:global>
  .main-home {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
  }

  /* Trust Strip */
  .trust-strip {
    padding: 32px 24px;
    background: var(--canvas-soft, #F7F7F7);
    border-top: 1px solid var(--hairline, #E5E5E5);
    border-bottom: 1px solid var(--hairline, #E5E5E5);
  }
  .trust-strip-inner {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 40px;
    flex-wrap: wrap;
  }
  .trust-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }
  .trust-value {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--ink, #0A0A0A);
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .trust-label {
    font-size: 0.75rem;
    color: var(--mute, #A3A3A3);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
  }
  .trust-divider {
    width: 1px;
    height: 40px;
    background: var(--hairline, #E5E5E5);
  }

  /* Quick Actions */
  .quick-actions {
    padding: 40px 24px;
    max-width: 900px;
    margin: 0 auto;
  }
  .quick-actions-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .quick-card {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 20px 24px;
    background: var(--canvas, #FFFFFF);
    border: 1.5px solid var(--hairline, #E5E5E5);
    border-radius: 16px;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
  }
  .quick-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--cyan, #00B8D4), var(--violet, #9C27B0));
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .quick-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 32px rgba(0,0,0,0.08);
    border-color: transparent;
  }
  .quick-card:hover::before { opacity: 1; }
  .quick-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .quick-feedback .quick-icon {
    background: var(--cyan-soft, #E0F7FA);
    color: var(--cyan, #00B8D4);
  }
  .quick-learn .quick-icon {
    background: var(--violet-soft, #F3E5F5);
    color: var(--violet, #9C27B0);
  }
  .quick-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
    min-width: 0;
  }
  .quick-text strong {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--ink, #0A0A0A);
    letter-spacing: -0.01em;
  }
  .quick-text span {
    font-size: 0.8rem;
    color: var(--mute, #A3A3A3);
  }
  .quick-arrow {
    color: var(--mute, #A3A3A3);
    opacity: 0;
    transform: translateX(-8px);
    transition: all 0.3s ease;
    flex-shrink: 0;
  }
  .quick-card:hover .quick-arrow {
    opacity: 1;
    transform: translateX(0);
    color: var(--ink, #0A0A0A);
  }

  /* Modules */
  .modules-section {
    padding: 60px 24px 80px;
    border-top: 1px solid var(--hairline, #E5E5E5);
  }
  .container { max-width: 1400px; margin: 0 auto; }

  .modules-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 40px;
    gap: 16px;
  }
  .modules-header-text { flex: 1; }
  .modules-badge {
    display: inline-block;
    padding: 4px 12px;
    background: linear-gradient(135deg, var(--cyan-soft, #E0F7FA), var(--violet-soft, #F3E5F5));
    color: var(--cyan, #00B8D4);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    border-radius: 20px;
    margin-bottom: 12px;
  }
  .modules-title {
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    color: var(--ink, #0A0A0A);
    margin: 0 0 8px 0;
    background: linear-gradient(135deg, var(--ink, #0A0A0A) 0%, var(--body, #525252) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .modules-desc { font-size: 0.95rem; color: var(--body, #525252); line-height: 1.5; margin: 0; }

  .modules-nav { display: none; gap: 8px; }
  .nav-arrow {
    width: 44px; height: 44px;
    border-radius: 50%;
    border: 1.5px solid var(--hairline, #E5E5E5);
    background: var(--canvas, #FFFFFF);
    color: var(--ink, #0A0A0A);
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
  }
  .nav-arrow:hover:not(.disabled) {
    background: var(--ink, #0A0A0A);
    color: var(--canvas, #FFFFFF);
    border-color: var(--ink, #0A0A0A);
    transform: scale(1.05);
  }
  .nav-arrow.disabled { opacity: 0.4; cursor: not-allowed; }

  .modules-scroll-wrapper { position: relative; margin: 0 -24px; padding: 0 24px; }

  .modules-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .module-card {
    text-decoration: none;
    display: block;
    position: relative;
    border-radius: 16px;
    background: var(--canvas, #FFFFFF);
    border: 1px solid var(--hairline, #E5E5E5);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    overflow: hidden;
  }
  .module-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--cyan, #00B8D4), var(--violet, #9C27B0));
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .module-card:hover {
    border-color: transparent;
    transform: translateY(-4px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.08);
  }
  .module-card:hover::before { opacity: 1; }

  .module-card-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: 28px 20px;
    position: relative;
  }
  .module-icon {
    width: 56px; height: 56px;
    border-radius: 14px;
    display: flex; align-items: center; justify-content: center;
    background: var(--icon-bg, var(--cyan-soft));
    color: var(--icon-color, var(--cyan));
    border: 1px solid var(--hairline, #E5E5E5);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    flex-shrink: 0;
  }
  .module-card:hover .module-icon {
    transform: scale(1.1) rotate(-5deg);
    box-shadow: 0 8px 20px rgba(0,0,0,0.1);
  }
  .module-content {
    display: flex; flex-direction: column; align-items: center;
    gap: 4px; text-align: center; flex: 1;
  }
  .module-name { font-size: 0.95rem; font-weight: 600; color: var(--ink, #0A0A0A); letter-spacing: -0.02em; }
  .module-desc { font-size: 0.8rem; color: var(--mute, #A3A3A3); }
  .module-arrow {
    position: absolute;
    top: 16px; right: 16px;
    width: 28px; height: 28px;
    border-radius: 50%;
    background: var(--hairline, #F5F5F5);
    display: flex; align-items: center; justify-content: center;
    color: var(--mute, #A3A3A3);
    opacity: 0; transform: translateX(-8px);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .module-card:hover .module-arrow {
    opacity: 1; transform: translateX(0);
    background: var(--ink, #0A0A0A);
    color: var(--canvas, #FFFFFF);
  }

  .modules-dots {
    display: none;
    justify-content: center;
    align-items: center;
    gap: 6px;
    margin-top: 24px;
  }
  .dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--hairline, #E5E5E5);
    border: none; padding: 0;
    cursor: pointer;
    transition: all 0.3s ease;
  }
  .dot.active { width: 20px; border-radius: 3px; background: var(--ink, #0A0A0A); }

  /* Responsive */
  @media (max-width: 1024px) {
    .modules-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 767px) {
    .trust-strip-inner { gap: 24px; }
    .trust-value { font-size: 1.5rem; }
    .trust-divider { height: 30px; }

    .quick-actions { padding: 24px 16px; }
    .quick-actions-inner { grid-template-columns: 1fr; }

    .modules-header { flex-direction: column; align-items: flex-start; gap: 20px; }
    .modules-nav { display: flex; align-self: flex-end; }
    .modules-scroll-wrapper { overflow: visible; }
    .modules-grid {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      padding: 8px 0 16px;
      gap: 12px;
    }
    .modules-grid::-webkit-scrollbar { display: none; }
    .module-card { flex: 0 0 260px; scroll-snap-align: start; }
    .module-card-inner { flex-direction: row; align-items: center; padding: 20px; gap: 16px; text-align: left; }
    .module-content { align-items: flex-start; text-align: left; }
    .module-arrow { position: static; opacity: 0.6; transform: none; flex-shrink: 0; }
    .modules-dots { display: flex; }
  }

  @media (max-width: 479px) {
    .modules-section { padding: 48px 16px 64px; }
    .modules-scroll-wrapper { margin: 0 -16px; padding: 0 16px; }
    .module-card { flex: 0 0 240px; }
  }

  /* Floating Write Blog FAB */
  .write-fab {
    position: fixed;
    bottom: 104px; /* sits above the AI chat bubble (assumed ~80px) */
    right: 24px;
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--ink, #171717);
    color: #fff;
    border-radius: 100px;
    padding: 12px 16px;
    text-decoration: none;
    font-size: 13px;
    font-weight: 700;
    box-shadow: 0 4px 16px rgba(0,0,0,0.18);
    z-index: 90;
    transition: all 0.25s cubic-bezier(0.16,1,0.3,1);
    overflow: hidden;
    max-width: 52px; /* collapsed — shows only icon */
    white-space: nowrap;
  }
  .write-fab:hover {
    max-width: 160px; /* expands to show label */
    background: #222;
    box-shadow: 0 8px 24px rgba(0,0,0,0.22);
    transform: translateY(-2px);
  }
  .fab-label {
    opacity: 0;
    width: 0;
    overflow: hidden;
    transition: opacity 0.2s 0.05s, width 0.25s;
  }
  .write-fab:hover .fab-label {
    opacity: 1;
    width: auto;
  }

  @media (max-width: 767px) {
    .write-fab {
      bottom: 88px;
      right: 16px;
      padding: 11px 14px;
    }
  }

</style>