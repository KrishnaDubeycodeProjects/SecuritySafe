---
import Layout from '../layouts/Layout.astro';
import ScoreDashboard from '../components/ScoreDashboard.astro';
import { calculateSafeScore } from '../utils/safeScore';
---

<Layout title="SAFE Score - Digital Safety Rating" currentPage="more" description="Check your personal digital safety score.">
  <main class="score-page">
    <div class="container">
      <div class="page-header">
        <h1>Your SAFE Score</h1>
        <p>Your personal digital safety rating based on your habits and security posture.</p>
      </div>

      <ScoreDashboard score={calculateSafeScore()} />

      <div class="score-info">
        <h3>What is SAFE Score?</h3>
        <p>SAFE Score measures your digital safety habits on a scale of 1-10. It considers your password strength, fraud awareness, account security, and overall risk exposure.</p>
        <p>The higher your score, the safer you are online. Complete learning modules, enable 2FA, and report scams to improve your score.</p>
      </div>

      <div class="score-legend">
        <div class="legend-item">
          <span class="legend-dot" style="background: var(--green)"></span>
          <span>8-10: Excellent - You are very safe online</span>
        </div>
        <div class="legend-item">
          <span class="legend-dot" style="background: #4ade80"></span>
          <span>6-7: Good - Decent safety, room for improvement</span>
        </div>
        <div class="legend-item">
          <span class="legend-dot" style="background: var(--amber)"></span>
          <span>4-5: Fair - Needs attention</span>
        </div>
        <div class="legend-item">
          <span class="legend-dot" style="background: #fb923c"></span>
          <span>2-3: Poor - High risk</span>
        </div>
        <div class="legend-item">
          <span class="legend-dot" style="background: var(--red)"></span>
          <span>1: Critical - Immediate action needed</span>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style is:global>
  .score-page {
    max-width: 800px;
    margin: 0 auto;
    padding: var(--space-lg) 0;
  }

  .page-header {
    text-align: center;
    padding-bottom: var(--space-xs);
  }

  .page-header h1 {
    font-size: 24px;
    color: var(--ink);
    margin-bottom: var(--space-xs);
  }

  .page-header p {
    font-size: 14px;
    color: var(--body);
    line-height: 1.5;
    padding: 0 var(--space-md);
  }

  .score-info {
    padding: 0 var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .score-info h3 {
    font-size: 14px;
    color: var(--ink);
    margin-bottom: var(--space-xs);
  }

  .score-info p {
    font-size: 13px;
    color: var(--body);
    line-height: 1.6;
    margin-bottom: var(--space-xs);
  }

  .score-legend {
    padding: 0 var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: 13px;
    color: var(--body);
  }

  .legend-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }
</style>
