---
import Layout from '../layouts/Layout.astro';
import { threatDatabase, getCriticalThreats, getThreatsByType } from '../utils/threatDatabase';

const criticalThreats = getCriticalThreats();
---

<Layout title="SAFE - Threat Database" currentPage="more" description="Browse known cyber threats and scam patterns.">
  <main class="database-page">
    <div class="container">
      <div class="page-header">
        <h1>Threat Database</h1>
        <p>Intelligence network of {threatDatabase.length} confirmed threats.</p>
      </div>

      {criticalThreats.length > 0 && (
        <div class="critical-section">
          <h2 class="section-title critical">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--red)" stroke-width="2">
              <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
              <line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
            </svg>
            Critical Threats
          </h2>
          <div class="critical-list">
            {criticalThreats.map((threat) => (
              <div class="threat-card critical">
                <div class="threat-type-badge">{threat.type}</div>
                <div class="threat-value">{threat.value}</div>
                <div class="threat-category">{threat.threatType}</div>
                <p class="threat-desc">{threat.description}</p>
                <div class="threat-footer">
                  <span class="threat-reports">{threat.reportCount} reports</span>
                  <span class="threat-severity">CRITICAL</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      <div class="database-tabs">
        <button class="db-tab active" data-type="all" onclick="filterDB('all')">All</button>
        <button class="db-tab" data-type="url" onclick="filterDB('url')">URLs</button>
        <button class="db-tab" data-type="phone" onclick="filterDB('phone')">Phones</button>
        <button class="db-tab" data-type="whatsapp" onclick="filterDB('whatsapp')">WhatsApp</button>
        <button class="db-tab" data-type="app" onclick="filterDB('app')">Apps</button>
      </div>

      <div id="db-list" class="db-list">
        {threatDatabase.map((threat) => (
          <div class="threat-card" data-type={threat.type}>
            <div class="threat-type-badge">{threat.type}</div>
            <div class="threat-value">{threat.value}</div>
            <div class="threat-category">{threat.threatType}</div>
            <p class="threat-desc">{threat.description}</p>
            <div class="threat-footer">
              <span class="threat-reports">{threat.reportCount} reports</span>
              <span class="threat-severity" data-level={threat.severity}>{threat.severity}</span>
              <span class="threat-status" data-status={threat.status}>{threat.status}</span>
            </div>
            <div class="threat-tags">
              {threat.tags.map((tag) => (
                <span class="threat-tag">{tag}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </main>
</Layout>

<script>
  window.filterDB = function(type) {
    document.querySelectorAll('.db-tab').forEach(el => el.classList.remove('active'));
    document.querySelector(`.db-tab[data-type="${type}"]`).classList.add('active');
    document.querySelectorAll('.threat-card').forEach(el => {
      if (type === 'all') {
        el.style.display = 'block';
      } else {
        el.style.display = el.dataset.type === type ? 'block' : 'none';
      }
    });
  };
</script>

<style is:global>
  .database-page {
    max-width: 900px;
    margin: 0 auto;
    padding: var(--space-lg) 0;
  }

  .page-header {
    text-align: center;
    padding: 0 var(--space-md) var(--space-lg);
  }

  .page-header h1 {
    font-size: 24px;
    color: var(--ink);
    margin-bottom: var(--space-xs);
  }

  .page-header p {
    font-size: 14px;
    color: var(--body);
  }

  .critical-section {
    padding: 0 var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .section-title {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: var(--space-sm);
  }

  .section-title.critical {
    color: var(--red);
  }

  .critical-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .database-tabs {
    display: flex;
    gap: var(--space-xs);
    padding: 0 var(--space-md);
    margin-bottom: var(--space-lg);
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .db-tab {
    padding: var(--space-xs) var(--space-md);
    background: var(--canvas);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-md);
    color: var(--body);
    font-size: 13px;
    font-weight: 500;
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .db-tab.active {
    background: rgba(0, 255, 136, 0.08);
    border-color: var(--green);
    color: var(--green);
  }

  .db-list {
    padding: 0 var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .threat-card {
    padding: var(--space-md);
    background: var(--canvas);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-lg);
    transition: all 0.2s ease;
  }

  .threat-card.critical {
    border-color: rgba(255, 23, 68, 0.3);
    background: rgba(255, 23, 68, 0.03);
  }

  .threat-type-badge {
    display: inline-block;
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: var(--space-xxs) var(--space-xs);
    border-radius: var(--radius-xs);
    background: rgba(0, 255, 136, 0.06);
    border: 1px solid rgba(0, 255, 136, 0.1);
    color: var(--green);
    margin-bottom: var(--space-xs);
  }

  .threat-value {
    font-size: 15px;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: var(--space-xxs);
    word-break: break-all;
    font-family: 'SF Mono', 'Fira Code', monospace;
  }

  .threat-category {
    font-size: 12px;
    color: var(--body);
    margin-bottom: var(--space-xs);
    font-weight: 500;
  }

  .threat-desc {
    font-size: 13px;
    color: var(--body);
    line-height: 1.5;
    margin-bottom: var(--space-sm);
  }

  .threat-footer {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
    flex-wrap: wrap;
  }

  .threat-reports {
    font-size: 11px;
    color: var(--body);
  }

  .threat-severity {
    font-size: 10px;
    font-weight: 700;
    padding: var(--space-xxs) var(--space-xs);
    border-radius: var(--radius-xs);
    letter-spacing: 0.5px;
  }

  .threat-severity[data-level="CRITICAL"] {
    background: rgba(255, 23, 68, 0.1);
    color: var(--red);
  }

  .threat-severity[data-level="HIGH"] {
    background: rgba(255, 184, 0, 0.1);
    color: var(--amber);
  }

  .threat-severity[data-level="MEDIUM"] {
    background: rgba(124, 111, 255, 0.1);
    color: var(--purple);
  }

  .threat-status {
    font-size: 10px;
    font-weight: 600;
    padding: var(--space-xxs) var(--space-xs);
    border-radius: var(--radius-xs);
    text-transform: uppercase;
  }

  .threat-status[data-status="confirmed"] {
    background: rgba(0, 255, 136, 0.1);
    color: var(--green);
  }

  .threat-status[data-status="investigating"] {
    background: rgba(255, 184, 0, 0.1);
    color: var(--amber);
  }

  .threat-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xxs);
  }

  .threat-tag {
    font-size: 10px;
    padding: var(--space-xxs) var(--space-xs);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--radius-xs);
    color: var(--body);
  }
</style>
