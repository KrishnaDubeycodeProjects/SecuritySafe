---
import Layout from '../../layouts/Layout.astro';
import { fraudTypes, fraudCategories } from '../../utils/learnData';

export function getStaticPaths() {
  return fraudTypes.map((fraud) => ({
    params: { id: fraud.id },
    props: { fraud },
  }));
}

const { fraud } = Astro.props;

// 1. Find Related Scams (Same Category, excluding current one)
const currentCategory = fraudCategories.find(c => c.id === fraud.categoryId);
const relatedScams = currentCategory?.fraudTypeIds
  .filter(id => id !== fraud.id)
  .slice(0, 2) // Limit to 2 related scams
  .map(id => fraudTypes.find(f => f.id === id))
  .filter(Boolean) as typeof fraudTypes;
---

<Layout title={`SAFE - ${fraud.title}`} currentPage="learn">
  <main class="detail-page">
    <a href="/learn" class="back-link">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
      Back to Categories
    </a>

    <header class="detail-header">
      <div class="detail-icon">{fraud.icon}</div>
      <h1>{fraud.title}</h1>
      <p class="detail-subtitle">Part of {currentCategory?.title || 'General Scams'}</p>
    </header>

    <!-- SECTION 1: THE LEARNING CONTENT -->
    <article class="content-article">
      <section class="chunk">
        <h2>How It Works</h2>
        <p>{fraud.howItWorks}</p>
      </section>

      <section class="chunk example-chunk">
        <h2>Real Example</h2>
        <div class="example-box">{fraud.realExample}</div>
      </section>

      <section class="chunk">
        <h2>Red Flags 🚩</h2>
        <ul class="flag-list">
          {fraud.redFlags.map(flag => <li>{flag}</li>)}
        </ul>
      </section>

      <section class="chunk">
        <h2>Protection Steps 🛡️</h2>
        <ul class="protect-list">
          {fraud.protectionSteps.map(step => <li>{step}</li>)}
        </ul>
      </section>
    </article>

    <!-- SECTION 2: QUIZ TRIGGER -->
    <div class="quiz-trigger-container" id="quiz-trigger-container">
      <div class="quiz-prompt">
        <h3>Ready to test your knowledge?</h3>
        <p>Take a quick quiz to see if you can spot this scam in real life.</p>
        <button id="start-quiz-btn" class="btn-primary">
          Start Quiz
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </button>
      </div>
    </div>

    <!-- SECTION 3: THE QUIZ (Hidden Initially) -->
    <section class="quiz-section hidden" id="quiz-section">
      <div class="quiz-card">
        <h2 class="quiz-title">Quick Quiz</h2>
        <p class="quiz-question">{fraud.quiz.question}</p>
        
        <div class="quiz-options">
          {fraud.quiz.options.map((option, i) => (
            <button class="quiz-option" data-correct={i === fraud.quiz.correctIndex} data-explanation={fraud.quiz.explanation}>
              <span class="option-letter">{String.fromCharCode(65 + i)}</span>
              <span class="option-text">{option}</span>
            </button>
          ))}
        </div>
        
        <div class="quiz-result hidden" id="quiz-result">
          <div class="result-icon"></div>
          <div class="result-text">
            <h3 class="result-title"></h3>
            <p class="result-explanation"></p>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 4: RELATED SCAMS -->
    {relatedScams.length > 0 && (
      <section class="related-section">
        <h2>Related Scams You Should Know</h2>
        <div class="related-grid">
          {relatedScams.map(related => (
            <a href={`/learn/${related.id}`} class="related-card">
              <span class="rel-icon">{related.icon}</span>
              <div>
                <h3>{related.title}</h3>
                <p>Learn more →</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}
  </main>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Quiz Toggle Logic
    const startBtn = document.getElementById('start-quiz-btn');
    const triggerContainer = document.getElementById('quiz-trigger-container');
    const quizSection = document.getElementById('quiz-section');

    if (startBtn && quizSection && triggerContainer) {
      startBtn.addEventListener('click', () => {
        triggerContainer.style.display = 'none';
        quizSection.classList.remove('hidden');
        quizSection.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });
    }

    // 2. Quiz Interaction Logic
    const options = document.querySelectorAll('.quiz-option');
    const resultDiv = document.getElementById('quiz-result');
    
    if (resultDiv) {
      const resultIcon = resultDiv.querySelector('.result-icon');
      const resultTitle = resultDiv.querySelector('.result-title');
      const resultExplanation = resultDiv.querySelector('.result-explanation');

      options.forEach(btn => {
        btn.addEventListener('click', () => {
          if (btn.disabled) return;
          const isCorrect = btn.dataset.correct === 'true';
          const explanation = btn.dataset.explanation;

          options.forEach(opt => opt.disabled = true);
          if (isCorrect) btn.classList.add('correct');
          else {
            btn.classList.add('wrong');
            options.forEach(opt => { if (opt.dataset.correct === 'true') opt.classList.add('correct'); });
          }

          resultDiv.classList.remove('hidden');
          resultDiv.className = `quiz-result ${isCorrect ? 'result-correct' : 'result-wrong'}`;
          
          resultIcon.innerHTML = isCorrect 
            ? '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>'
            : '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>';
            
          resultTitle.textContent = isCorrect ? '✅ Correct!' : '❌ Incorrect';
          resultExplanation.textContent = explanation;
        });
      });
    }
  });
</script>

<style is:global>
  .detail-page { max-width: 720px; margin: 0 auto; padding: 40px 20px 80px; }
  .back-link { display: inline-flex; align-items: center; gap: 6px; color: var(--green); text-decoration: none; font-size: 14px; font-weight: 500; margin-bottom: 32px; }
  
  .detail-header { text-align: center; margin-bottom: 48px; }
  .detail-icon { font-size: 64px; margin-bottom: 16px; }
  .detail-header h1 { font-size: 32px; margin: 0; color: var(--ink); }
  .detail-subtitle { font-size: 14px; color: var(--text-dim); margin-top: 8px; text-transform: uppercase; letter-spacing: 1px; }

  .content-article { margin-bottom: 48px; }
  .chunk { margin-bottom: 32px; }
  .chunk h2 { font-size: 20px; margin-bottom: 12px; color: var(--ink); }
  .chunk p { font-size: 16px; line-height: 1.7; color: var(--body); margin: 0; }
  
  .example-box { padding: 20px; background: rgba(255, 184, 0, 0.06); border: 1px solid rgba(255, 184, 0, 0.2); border-radius: 12px; font-style: italic; color: var(--amber); }
  
  .flag-list, .protect-list { list-style: none; padding: 0; }
  .flag-list li, .protect-list li { position: relative; padding: 10px 0 10px 32px; border-bottom: 1px solid var(--border); }
  .flag-list li::before { content: '⚠️'; position: absolute; left: 0; }
  .protect-list li::before { content: '✅'; position: absolute; left: 0; }

  /* QUIZ TRIGGER */
  .quiz-trigger-container { text-align: center; padding: 40px; background: var(--bg-muted); border-radius: 16px; margin-bottom: 48px; }
  .quiz-prompt h3 { font-size: 20px; margin-bottom: 8px; }
  .btn-primary { background: var(--green); color: #000; border: none; padding: 12px 24px; border-radius: 99px; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; font-size: 15px; margin-top: 16px; transition: transform 0.2s; }
  .btn-primary:hover { transform: scale(1.05); }

  /* QUIZ SECTION */
  .quiz-section.hidden { display: none; }
  .quiz-card { background: rgba(124, 111, 255, 0.05); border: 1px solid rgba(124, 111, 255, 0.2); border-radius: 16px; padding: 32px; }
  .quiz-title { font-size: 24px; color: var(--purple); margin-bottom: 24px; text-align: center; }
  .quiz-question { font-size: 18px; font-weight: 600; margin-bottom: 24px; line-height: 1.4; }
  
  .quiz-options { display: flex; flex-direction: column; gap: 12px; }
  .quiz-option { display: flex; align-items: center; gap: 16px; width: 100%; padding: 16px; background: rgba(255, 255, 255, 0.04); border: 1px solid var(--border); border-radius: 12px; text-align: left; cursor: pointer; }
  .quiz-option:hover:not(:disabled) { border-color: var(--green); background: rgba(0, 255, 136, 0.08); }
  .quiz-option.correct { background: rgba(0, 255, 136, 0.15); border-color: var(--green); color: var(--green); }
  .quiz-option.wrong { background: rgba(255, 23, 68, 0.15); border-color: var(--red); color: var(--red); }
  .quiz-option:disabled { opacity: 0.8; cursor: default; }
  .option-letter { width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; background: rgba(255, 255, 255, 0.08); border-radius: 8px; font-weight: 700; }

  .quiz-result { display: flex; align-items: flex-start; gap: 16px; margin-top: 24px; padding: 20px; border-radius: 12px; animation: fadeIn 0.3s; }
  .result-correct { background: rgba(0, 255, 136, 0.1); border: 1px solid rgba(0, 255, 136, 0.3); }
  .result-wrong { background: rgba(255, 23, 68, 0.1); border: 1px solid rgba(255, 23, 68, 0.3); }
  .result-icon { flex-shrink: 0; margin-top: 2px; }
  .result-correct .result-icon { color: var(--green); }
  .result-wrong .result-icon { color: var(--red); }
  .result-title { font-size: 18px; margin: 0 0 4px 0; }
  .result-explanation { font-size: 14px; line-height: 1.6; margin: 0; }

  /* RELATED SCAMS */
  .related-section { margin-top: 60px; padding-top: 40px; border-top: 2px dashed var(--border); }
  .related-section h2 { font-size: 20px; margin-bottom: 24px; }
  .related-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .related-card { display: flex; align-items: center; gap: 12px; padding: 16px; background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px; text-decoration: none; color: inherit; transition: border-color 0.2s; }
  .related-card:hover { border-color: var(--green); }
  .rel-icon { font-size: 24px; }
  .related-card h3 { font-size: 14px; margin: 0 0 2px 0; }
  .related-card p { font-size: 12px; color: var(--green); margin: 0; }
  .hidden { display: none !important; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>