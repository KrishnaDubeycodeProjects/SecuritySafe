---
import Layout from '../layouts/Layout.astro';
import LearnCard from '../components/LearnCard.astro';
import { fraudTypes } from '../utils/learnData';
---

<Layout title="SAFE - Learn About Scams" currentPage="learn" description="Learn about different types of online frauds and how to protect yourself.">
  <main class="learn-page">
    <div class="learn-header">
      <h1>Learn About Frauds</h1>
      <p>Know your enemy. Understanding scams is the first step to staying safe.</p>
    </div>
    <div class="learn-grid">
      {fraudTypes.map((fraud, index) => (
        <LearnCard fraud={fraud} index={index} />
      ))}
    </div>
    <div class="learn-footer">
      <div class="safe-tip">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        </svg>
        <span>Remember: If something feels wrong, it probably is. Trust your instincts.</span>
      </div>
    </div>
  </main>
</Layout>

<style is:global>
  .learn-page {
    width: 100%;
    max-width: 900px;
    margin: 0 auto;
    padding: var(--space-xl) var(--space-md) var(--space-lg);
  }

  .learn-header {
    text-align: center;
    margin-bottom: var(--space-xl);
  }

  .learn-header h1 {
    font-size: 28px;
    color: var(--ink);
    margin-bottom: var(--space-xs);
  }

  .learn-header p {
    font-size: 15px;
    color: var(--body);
    line-height: 1.5;
    max-width: 500px;
    margin: 0 auto;
  }

  .learn-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
  }

  .learn-footer {
    margin-top: var(--space-xl);
  }

  @media (min-width: 640px) {
    .learn-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .learn-header h1 {
      font-size: 32px;
    }
  }

  @media (min-width: 1024px) {
    .learn-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .learn-page {
      padding: var(--space-3xl) var(--space-xl) var(--space-xl);
    }

    .learn-header h1 {
      font-size: 36px;
    }
  }

  .safe-tip {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    padding: var(--space-md);
    background: rgba(0, 255, 136, 0.04);
    border: 1px solid rgba(0, 255, 136, 0.1);
    border-radius: var(--radius-lg);
    font-size: 13px;
    color: var(--body);
    line-height: 1.5;
  }

  .safe-tip svg {
    flex-shrink: 0;
    margin-top: 2px;
  }
</style>
