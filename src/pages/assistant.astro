---
import Layout from '../layouts/Layout.astro';
import AIAssistant from '../components/AIAssistant.astro';
---

<Layout title="SAFE - AI Assistant" currentPage="more" description="Ask SAFE AI about any cyber safety concern.">
  <main class="assistant-page">
    <AIAssistant />
  </main>
</Layout>

<style is:global>
  .assistant-page {
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
    padding: 24px 16px;
    height: calc(100vh - var(--nav-height) - 48px);
    display: flex;
    flex-direction: column;
  }

  .assistant-page .container {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  @media (min-width: 768px) {
    .assistant-page {
      padding: 32px 24px;
      height: calc(100vh - 48px);
    }
  }
</style>
