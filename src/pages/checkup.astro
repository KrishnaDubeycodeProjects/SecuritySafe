---
import Layout from '../layouts/Layout.astro';
import CheckupCard from '../components/CheckupCard.astro';
import { checkupItems, getCheckupSummary } from '../utils/checkupData';
---

<Layout title="SAFE - Security Checkup" currentPage="more" description="Audit your personal digital safety.">
  <main class="checkup-page">
    <div class="container">
      <div class="page-header">
        <h1>Security Checkup</h1>
        <p>Audit your digital safety across all areas.</p>
      </div>

      <div class="checkup-summary">
        <div class="summary-item secure">
          <span class="summary-count">{getCheckupSummary().secure}</span>
          <span class="summary-label">Secure</span>
        </div>
        <div class="summary-item at-risk">
          <span class="summary-count">{getCheckupSummary().atRisk}</span>
          <span class="summary-label">At Risk</span>
        </div>
        <div class="summary-item action">
          <span class="summary-count">{getCheckupSummary().actionNeeded}</span>
          <span class="summary-label">Action Needed</span>
        </div>
        <div class="summary-item unknown">
          <span class="summary-count">{getCheckupSummary().unknown}</span>
          <span class="summary-label">Unknown</span>
        </div>
      </div>

      <div class="checkup-list">
        {checkupItems.map((item) => (
          <CheckupCard item={item} />
        ))}
      </div>

      <div class="checkup-cta">
        <p>Complete these actions to improve your digital safety score.</p>
      </div>
    </div>
  </main>
</Layout>

<style is:global>
  .checkup-page {
    max-width: 900px;
    margin: 0 auto;
    padding: var(--space-lg) 0;
  }

  .page-header {
    text-align: center;
    padding: 0 var(--space-md) var(--space-lg);
  }

  .page-header h1 {
    font-size: 24px;
    color: var(--ink);
    margin-bottom: var(--space-xs);
  }

  .page-header p {
    font-size: 14px;
    color: var(--body);
  }

  .checkup-summary {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-xs);
    padding: 0 var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .summary-item {
    text-align: center;
    padding: var(--space-sm) var(--space-xxs);
    background: var(--canvas);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-lg);
  }

  .summary-count {
    display: block;
    font-size: 24px;
    font-weight: 800;
    font-family: var(--font-display);
    margin-bottom: 2px;
  }

  .summary-label {
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-weight: 600;
  }

  .summary-item.secure .summary-count { color: var(--green); }
  .summary-item.secure .summary-label { color: var(--green); }
  .summary-item.at-risk .summary-count { color: var(--amber); }
  .summary-item.at-risk .summary-label { color: var(--amber); }
  .summary-item.action .summary-count { color: var(--red); }
  .summary-item.action .summary-label { color: var(--red); }
  .summary-item.unknown .summary-count { color: var(--body); }
  .summary-item.unknown .summary-label { color: var(--body); }

  .checkup-list {
    padding: 0 var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .checkup-cta {
    padding: 0 var(--space-md) var(--space-lg);
    text-align: center;
  }

  .checkup-cta p {
    font-size: 13px;
    color: var(--body);
    line-height: 1.5;
  }
</style>
