---
import Layout from '../layouts/Layout.astro';
---

<Layout title="SAFE - More Modules" currentPage="more" description="All SAFE modules and features.">
  <main class="more-page">
    <div class="container">
      <div class="page-header">
        <h1>All Modules</h1>
        <p>Complete suite of cyber safety tools</p>
      </div>

      <div class="more-modules">
        <a href="/" class="more-card">
          <div class="more-icon scan-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
          </div>
          <div class="more-info">
            <h3>Universal Scanner</h3>
            <p>Scan messages, links, numbers & emails instantly</p>
          </div>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--body)" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        </a>

        <a href="/learn" class="more-card">
          <div class="more-icon learn-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
          </div>
          <div class="more-info">
            <h3>Fraud Learning Center</h3>
            <p>Interactive lessons and quizzes on scam types</p>
          </div>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--body)" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        </a>

        <a href="/report" class="more-card">
          <div class="more-icon report-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
          </div>
          <div class="more-info">
            <h3>Community Reporting</h3>
            <p>Report scams and protect the community</p>
          </div>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--body)" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        </a>

        <a href="/emergency" class="more-card">
          <div class="more-icon emergency-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          </div>
          <div class="more-info">
            <h3>Emergency Response Center</h3>
            <p>Immediate steps after falling victim to fraud</p>
          </div>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--body)" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        </a>

        <a href="/database" class="more-card">
          <div class="more-icon db-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>
          </div>
          <div class="more-info">
            <h3>Threat Database</h3>
            <p>Intelligence network of known threats and patterns</p>
          </div>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--body)" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        </a>

        <a href="/score" class="more-card">
          <div class="more-icon score-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
          </div>
          <div class="more-info">
            <h3>SAFE Score</h3>
            <p>Measure your digital safety habits</p>
          </div>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--body)" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        </a>

        <a href="/checkup" class="more-card">
          <div class="more-icon checkup-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
          <div class="more-info">
            <h3>Security Checkup</h3>
            <p>Audit your complete digital safety</p>
          </div>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--body)" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        </a>

        <a href="/assistant" class="more-card">
          <div class="more-icon ai-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          </div>
          <div class="more-info">
            <h3>AI Assistant</h3>
            <p>Your personal cyber safety companion</p>
          </div>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--body)" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        </a>

        <a href="/news" class="more-card">
          <div class="more-icon news-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2zm0 0a2 2 0 0 1-2-2v-9h2"/><line x1="10" y1="8" x2="18" y2="8"/><line x1="10" y1="12" x2="18" y2="12"/><line x1="10" y1="16" x2="14" y2="16"/></svg>
          </div>
          <div class="more-info">
            <h3>News & Alerts</h3>
            <p>Latest cyber threats and safety tips</p>
          </div>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--body)" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        </a>

        <a href="/family" class="more-card">
          <div class="more-icon family-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <div class="more-info">
            <h3>Family Shield</h3>
            <p>Protect your entire family from threats</p>
          </div>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--body)" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        </a>

        <a href="/about" class="more-card">
          <div class="more-icon about-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
          </div>
          <div class="more-info">
            <h3>About SAFE</h3>
            <p>Mission, vision, roadmap and founder story</p>
          </div>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--body)" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        </a>
      </div>

      <div class="more-premium">
        <div class="premium-card">
          <h3>SAFE Premium</h3>
          <p>Unlimited scans, advanced analysis, breach monitoring, family shield, dark web monitoring, and priority support.</p>
          <div class="premium-badge">Coming Soon</div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style is:global>
  .more-page {
    width: 100%;
    max-width: 900px;
    margin: 0 auto;
    padding: var(--space-xl) 0;
  }

  .page-header {
    text-align: center;
    padding: 0 var(--space-md) var(--space-lg);
  }

  .page-header h1 {
    font-size: 24px;
    color: var(--ink);
    margin-bottom: var(--space-xs);
  }

  .page-header p {
    font-size: 14px;
    color: var(--body);
  }

  .more-modules {
    padding: 0 var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .more-card {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-md);
    background: var(--canvas);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-xl);
    text-decoration: none;
    margin-bottom: var(--space-xs);
    transition: all 0.2s ease;
  }

  .more-card:hover {
    border-color: rgba(0, 255, 136, 0.3);
  }

  .more-icon {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .scan-icon { background: rgba(0,255,136,0.08); color: var(--green); }
  .learn-icon { background: rgba(0,255,136,0.08); color: var(--green); }
  .report-icon { background: rgba(255,184,0,0.08); color: var(--amber); }
  .emergency-icon { background: rgba(255,23,68,0.08); color: var(--red); }
  .db-icon { background: rgba(255,23,68,0.08); color: var(--red); }
  .score-icon { background: rgba(0,255,136,0.08); color: var(--green); }
  .checkup-icon { background: rgba(124,111,255,0.08); color: var(--purple); }
  .ai-icon { background: rgba(0,255,136,0.08); color: var(--green); }
  .news-icon { background: rgba(255,184,0,0.08); color: var(--amber); }
  .family-icon { background: rgba(124,111,255,0.08); color: var(--purple); }
  .about-icon { background: rgba(0,255,136,0.08); color: var(--green); }

  .more-info {
    flex: 1;
    min-width: 0;
  }

  .more-info h3 {
    font-size: 14px;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 2px;
  }

  .more-info p {
    font-size: 12px;
    color: var(--body);
    line-height: 1.4;
  }

  .more-premium {
    padding: 0 var(--space-md) var(--space-lg);
  }

  .premium-card {
    text-align: center;
    padding: var(--space-lg);
    background: linear-gradient(135deg, rgba(0,255,136,0.04) 0%, rgba(124,111,255,0.04) 100%);
    border: 1px solid rgba(0,255,136,0.15);
    border-radius: var(--radius-xl);
  }

  .premium-card h3 {
    font-size: 18px;
    color: var(--green);
    margin-bottom: var(--space-xs);
  }

  .premium-card p {
    font-size: 13px;
    color: var(--body);
    line-height: 1.6;
    margin-bottom: var(--space-md);
  }

  .premium-badge {
    display: inline-block;
    padding: var(--space-xxs) var(--space-md);
    background: rgba(0,255,136,0.08);
    border: 1px solid rgba(0,255,136,0.2);
    border-radius: var(--radius-md);
    color: var(--green);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }
</style>
