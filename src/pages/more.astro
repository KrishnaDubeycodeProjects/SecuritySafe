---
import Layout from '../layouts/Layout.astro';
---

<Layout title="SAFE - More Modules" currentPage="more" description="All SAFE modules and features.">
 <!-- Google tag (gtag.js) -->

  <main class="more-page">
    <div class="container">
      <div class="page-header">
        <h1>All Features</h1>
        <p>Complete suite of cyber safety tools</p>
      </div>

      <div class="more-modules">
        <a href="/" class="more-card">
          <div class="more-icon scan-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
          </div>
          <div class="more-info">
            <h3>Universal Scanner</h3>
            <p>Scan messages, links, numbers & emails instantly</p>
          </div>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--body)" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        </a>

        <a href="/learn" class="more-card">
          <div class="more-icon learn-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
          </div>
          <div class="more-info">
            <h3>Fraud Learning Center</h3>
            <p>Interactive lessons and quizzes on scam types</p>
          </div>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--body)" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        </a>

     

        <a href="/emergency" class="more-card">
          <div class="more-icon emergency-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          </div>
          <div class="more-info">
            <h3>Emergency Response Center</h3>
            <p>Immediate steps after falling victim to fraud</p>
          </div>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--body)" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        </a>

        <a href="/about" class="more-card">
          <div class="more-icon about-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
          </div>
          <div class="more-info">
            <h3>About SAFE</h3>
            <p>Mission, vision, roadmap and founder story</p>
          </div>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--body)" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        </a>

        <a href="/feedback" class="more-card">
             
                <div class="more-icon about-icon" style="--icon-bg: var(--cyan-soft); --icon-color: var(--cyan);">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                  </svg>
                </div>
                <div class="more-info">
                  <h3>Feedback</h3>
                  <p>Help us to Improve your Experience</span>
                </div>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--body)" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
                  </svg>
               
            </a>


      </div>
    </div>

  </main>

</Layout>

<style is:global>
  .more-page {
    width: 100%;
    max-width: 900px;
    margin: 0 auto;
    padding: var(--space-xl) 0;
  }

  .page-header {
    text-align: center;
    padding: 0 var(--space-md) var(--space-lg);
  }

  .page-header h1 {
    font-size: 24px;
    color: var(--ink);
    margin-bottom: var(--space-xs);
  }

  .page-header p {
    font-size: 14px;
    color: var(--body);
  }

  .more-modules {
    padding: 0 var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .more-card {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-md);
    background: var(--canvas);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-xl);
    text-decoration: none;
    margin-bottom: var(--space-xs);
    transition: all 0.2s ease;
  }

  .more-card:hover {
    border-color: rgba(0, 255, 136, 0.3);
  }

  .more-icon {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .scan-icon { background: rgba(0,255,136,0.08); color: var(--green); }
  .learn-icon { background: rgba(0,255,136,0.08); color: var(--green); }
  .report-icon { background: rgba(255,184,0,0.08); color: var(--amber); }
  .emergency-icon { background: rgba(255,23,68,0.08); color: var(--red); }
  .db-icon { background: rgba(255,23,68,0.08); color: var(--red); }
  .score-icon { background: rgba(0,255,136,0.08); color: var(--green); }
  .checkup-icon { background: rgba(124,111,255,0.08); color: var(--purple); }
  .ai-icon { background: rgba(0,255,136,0.08); color: var(--green); }
  .news-icon { background: rgba(255,184,0,0.08); color: var(--amber); }
  .family-icon { background: rgba(124,111,255,0.08); color: var(--purple); }
  .about-icon { background: rgba(0,255,136,0.08); color: var(--green); }

  .more-info {
    flex: 1;
    min-width: 0;
  }

  .more-info h3 {
    font-size: 14px;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 2px;
  }

  .more-info p {
    font-size: 12px;
    color: var(--body);
    line-height: 1.4;
  }




</style>
