<section class="hero">
  <div class="container">
    <div class="hero-badge">
      <span class="badge-dot"></span>
      Free, straightforward scam checking in seconds.
    </div>

    <h1 class="hero-title">
      Not Sure if it's Safe?<br />
      <span class="gradient-text">Ask VerifyAI</span>
    </h1>

    <p class="hero-desc">
      Upload images, paste URLs, or check messages. We'll verify the safety instantly.
    </p>

    <!-- Mac Window Input Form -->
    <div class="mac-window input-window">
      <div class="mac-titlebar">
        <div class="mac-dots">
          <span class="mac-dot red"></span>
          <span class="mac-dot yellow"></span>
          <span class="mac-dot green"></span>
        </div>
        <span class="mac-title">VerifyAI — Scam Checker</span>
      </div>
      
      <div class="window-body">
        <div class="scan-tabs">
          <button class="tab-btn active" data-tab="website">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/></svg>
            Website
          </button>
          <button class="tab-btn" data-tab="text">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/></svg>
            Text
          </button>
          <button class="tab-btn" data-tab="image">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/></svg>
            Image
          </button>
        </div>

        <!-- Fixed height container to prevent layout jumps -->
        <div class="input-container">
          <div class="input-area active" id="inputWebsite">
            <input type="text" placeholder="https://example.com" class="url-input" />
            <button class="btn-primary check-btn">Check now →</button>
          </div>

          <div class="input-area" id="inputText">
            <textarea placeholder="Paste email, text message, or document body here..." class="text-input"></textarea>
            <button class="btn-primary check-btn">Check now →</button>
          </div>

          <div class="input-area" id="inputImage">
            <div class="dropzone">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#00E676" stroke-width="1.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
              <p>Drag and drop your images here, or click to browse</p>
              <button class="btn-secondary" style="padding: 8px 16px; font-size: 0.85rem;">Browse files</button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="trust-logos">
      <span>As seen in:</span>
      <div class="logos">
        <span>Daily Mail</span><span>The Telegraph</span><span>Independent</span><span>Daily Express</span>
      </div>
    </div>
  </div>
</section>


<style>
  .hero {
    padding: 140px 0 80px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    top: -200px;
    left: 50%;
    transform: translateX(-50%);
    width: 800px;
    height: 800px;
    background: radial-gradient(circle, rgba(0, 230, 118, 0.08) 0%, transparent 70%);
    pointer-events: none;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 20px;
    background: rgba(0, 230, 118, 0.08);
    border: 1px solid rgba(0, 230, 118, 0.2);
    border-radius: 100px;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--primary);
    margin-bottom: 32px;
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    background: var(--primary);
    border-radius: 50%;
    animation: pulse-glow 2s ease-in-out infinite;
  }

  .hero-title {
    font-size: 4.5rem;
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin-bottom: 20px;
  }

  .hero-subtitle {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--text-secondary);
    margin-bottom: 16px;
  }

  .hero-desc {
    font-size: 1.1rem;
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto 40px;
    line-height: 1.7;
  }

  .scan-tabs {
    display: inline-flex;
    gap: 4px;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 4px;
    margin-bottom: 32px;
  }

  .tab-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 24px;
    background: transparent;
    color: var(--text-secondary);
    font-size: 0.9rem;
    font-weight: 600;
    border-radius: 8px;
    transition: all 0.2s;
  }

  .tab-btn:hover {
    color: var(--text-primary);
  }

  .tab-btn.active {
    background: var(--primary);
    color: #000;
  }

  .upload-area {
    max-width: 600px;
    margin: 0 auto 40px;
    padding: 48px 32px;
    background: var(--bg-card);
    border: 2px dashed var(--border-light);
    border-radius: 20px;
    transition: all 0.3s;
  }

  .upload-area:hover {
    border-color: var(--primary);
    background: var(--bg-card-hover);
  }

  .upload-icon {
    margin-bottom: 16px;
  }

  .upload-area h3 {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 8px;
  }

  .upload-area p {
    color: var(--text-secondary);
    font-size: 0.9rem;
    margin-bottom: 24px;
  }

  .hero-actions {
    display: flex;
    justify-content: center;
    gap: 16px;
    margin-bottom: 60px;
  }

  .hero-image-wrapper {
    position: relative;
    max-width: 1000px;
    margin: 0 auto;
  }

  .hero-image-glow {
    position: absolute;
    inset: -40px;
    background: radial-gradient(ellipse at center, rgba(0, 230, 118, 0.12) 0%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
  }

  .hero-image {
    width: 100%;
    border-radius: 16px;
    border: 1px solid var(--border-color);
    box-shadow: var(--shadow-card), var(--shadow-glow);
  }

  @media (max-width: 768px) {
    .hero {
      padding: 120px 0 60px;
    }
    .hero-title {
      font-size: 2.5rem;
    }
    .hero-subtitle {
      font-size: 1.1rem;
    }
    .hero-desc {
      font-size: 1rem;
    }
    .hero-actions {
      flex-direction: column;
      align-items: center;
    }
    .scan-tabs {
      flex-wrap: wrap;
      justify-content: center;
    }
  }
</style>
<script>
  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      // Update active tab button
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      
      // Hide all input areas
      document.querySelectorAll('.input-area').forEach(a => a.classList.remove('active'));
      
      // Show the selected input area
      const tab = btn.getAttribute('data-tab');
      const targetId = 'input' + tab.charAt(0).toUpperCase() + tab.slice(1);
      document.getElementById(targetId)?.classList.add('active');
    });
  });
</script>