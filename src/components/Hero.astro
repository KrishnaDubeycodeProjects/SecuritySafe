---
---

<section class="hero">
  <div class="hero-mesh">
    <div class="mesh-gradient"></div>
    <div class="mesh-overlay"></div>
  </div>
  <div class="hero-content">
    <div class="hero-badge">Cyber Safety Platform</div>
    <h1 class="hero-title">Know if it's safe before you click.</h1>
    <p class="hero-subtext">Paste any message, link, number or email and get an instant safety analysis. Built for everyone in India.</p>
    <div class="hero-actions">
      <a href="#scanner" class="btn-primary">Start Scanning</a>
      <a href="SecuritySafe/learn" class="btn-secondary">Learn More</a>
    </div>
  </div>
</section>

<style is:global>
  .hero {
    position: relative;
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: var(--space-5xl) var(--space-md);
    text-align: center;
    background: var(--canvas-soft);
  }

  .hero-mesh {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .mesh-gradient {
    position: absolute;
    top: -20%;
    left: -10%;
    right: -10%;
    height: 70%;
    background:
      radial-gradient(ellipse 80% 60% at 20% 30%, rgba(0,124,240,0.3) 0%, transparent 60%),
      radial-gradient(ellipse 60% 50% at 80% 40%, rgba(121,40,202,0.2) 0%, transparent 50%),
      radial-gradient(ellipse 50% 40% at 50% 60%, rgba(0,223,216,0.15) 0%, transparent 50%),
      radial-gradient(ellipse 40% 40% at 70% 20%, rgba(255,0,128,0.12) 0%, transparent 50%);
    animation: mesh-shift 12s ease-in-out infinite alternate;
  }

  .mesh-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 50%, var(--canvas-soft) 100%);
  }

  @keyframes mesh-shift {
    0% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(-2%, 1%) scale(1.02); }
    66% { transform: translate(1%, -1%) scale(1.01); }
    100% { transform: translate(-1%, 2%) scale(1.03); }
  }

  .hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-lg);
    max-width: 640px;
  }

  .hero-badge {
    display: inline-block;
    padding: 4px 14px;
    background: var(--link-bg-soft);
    color: var(--link);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.02em;
    border-radius: var(--radius-full);
    text-transform: uppercase;
  }

  .hero-title {
    font-size: 2.5rem;
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.1;
    color: var(--ink);
    max-width: 600px;
  }

  .hero-subtext {
    font-size: 1.125rem;
    color: var(--body);
    max-width: 480px;
    line-height: 1.6;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    justify-content: center;
    margin-top: var(--space-xs);
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    padding: 12px 28px;
    background: var(--ink);
    color: var(--on-ink);
    font-size: 15px;
    font-weight: 500;
    border-radius: var(--radius-pill);
    text-decoration: none;
    transition: var(--transition);
    letter-spacing: -0.01em;
  }

  .btn-primary:hover {
    opacity: 0.9;
    transform: translateY(-1px);
    color: var(--on-ink);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    padding: 12px 28px;
    background: var(--canvas);
    color: var(--ink);
    font-size: 15px;
    font-weight: 500;
    border-radius: var(--radius-pill);
    text-decoration: none;
    border: 1px solid var(--hairline);
    transition: var(--transition);
    letter-spacing: -0.01em;
  }

  .btn-secondary:hover {
    border-color: var(--hairline-strong);
    color: var(--ink);
  }

  @media (min-width: 768px) {
    .hero {
      min-height: 85vh;
      padding: var(--space-6xl) var(--space-lg);
    }

    .hero-title {
      font-size: 3.5rem;
    }

    .hero-subtext {
      font-size: 1.25rem;
    }

    .btn-primary, .btn-secondary {
      padding: 14px 36px;
      font-size: 16px;
    }
  }

  @media (min-width: 1024px) {
    .hero-title {
      font-size: 4rem;
    }

    .hero-content {
      max-width: 720px;
    }
  }
</style>
