---
import type { LearnFraudType } from '../utils/types';

export interface Props {
  fraud: LearnFraudType;
  index: number;
}

const { fraud, index } = Astro.props;
---

<div class="learn-card" data-index={index}>
  <div class="card-header" onclick="toggleCard(event)">
    <div class="card-icon">{fraud.icon}</div>
    <div class="card-info">
      <h3 class="card-title">{fraud.title}</h3>
      <span class="card-status">Learn More →</span>
    </div>
  </div>
  <div class="card-body hidden">
    <div class="body-section">
      <h4 class="section-title">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
          <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
        </svg>
        How It Works
      </h4>
      <p>{fraud.howItWorks}</p>
    </div>
    <div class="body-section">
      <h4 class="section-title">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--amber)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
        </svg>
        Real Example
      </h4>
      <div class="example-box">{fraud.realExample}</div>
    </div>
    <div class="body-section">
      <h4 class="section-title">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--red)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
          <line x1="12" y1="9" x2="12" y2="13"/>
          <line x1="12" y1="17" x2="12.01" y2="17"/>
        </svg>
        Red Flags
      </h4>
      <ul class="flag-list">
        {fraud.redFlags.map(flag => (
          <li class="flag-item">{flag}</li>
        ))}
      </ul>
    </div>
    <div class="body-section">
      <h4 class="section-title">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        </svg>
        Protection Steps
      </h4>
      <ul class="protect-list">
        {fraud.protectionSteps.map(step => (
          <li class="protect-item">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            {step}
          </li>
        ))}
      </ul>
    </div>
    <div class="body-section quiz-section">
      <h4 class="section-title">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--purple)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/>
          <line x1="12" y1="17" x2="12.01" y2="17"/>
        </svg>
        Quick Quiz
      </h4>
      <p class="quiz-question">{fraud.quiz.question}</p>
      <div class="quiz-options">
        {fraud.quiz.options.map((option, i) => (
          <button class="quiz-option" data-correct={i === fraud.quiz.correctIndex} onclick="checkQuiz(event)">
            <span class="option-letter">{String.fromCharCode(65 + i)}</span>
            {option}
          </button>
        ))}
      </div>
      <div class="quiz-result hidden"></div>
    </div>
  </div>
</div>

<script>
  function toggleCard(e) {
    const card = e.currentTarget.closest('.learn-card');
    const body = card.querySelector('.card-body');
    const status = card.querySelector('.card-status');
    const isOpen = !body.classList.contains('hidden');

    if (isOpen) {
      body.classList.add('hidden');
      status.textContent = 'Learn More →';
    } else {
      body.classList.remove('hidden');
      status.textContent = '▼ Hide Details';
      card.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }

  function checkQuiz(e) {
    const btn = e.currentTarget;
    const card = btn.closest('.learn-card');
    const options = card.querySelectorAll('.quiz-option');
    const quizResult = card.querySelector('.quiz-result');
    const isCorrect = btn.dataset.correct === 'true';

    options.forEach(opt => opt.disabled = true);

    btn.classList.add(isCorrect ? 'correct' : 'wrong');

    if (!isCorrect) {
      options.forEach(opt => {
        if (opt.dataset.correct === 'true') {
          opt.classList.add('correct');
        }
      });
    }

    quizResult.classList.remove('hidden');
    quizResult.className = `quiz-result ${isCorrect ? 'result-correct' : 'result-wrong'}`;

    const explanation = btn.closest('.body-section').querySelector('.quiz-question').dataset.explanation || '';

    quizResult.innerHTML = `
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        ${isCorrect
          ? '<polyline points="20 6 9 17 4 12"/>'
          : '<line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>'
        }
      </svg>
      <span>${isCorrect ? '✅ Sahi jawab!' : '❌ Galat jawab'}</span>
    `;
  }

  // Make functions available to onclick handlers
  window.toggleCard = toggleCard;
  window.checkQuiz = checkQuiz;
</script>

<style is:global>
  .learn-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .learn-card:hover {
    border-color: rgba(0, 255, 136, 0.3);
    box-shadow: 0 0 15px rgba(0, 255, 136, 0.05);
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px;
    cursor: pointer;
    user-select: none;
  }

  .card-icon {
    font-size: 32px;
    line-height: 1;
  }

  .card-info {
    flex: 1;
  }

  .card-title {
    font-size: 16px;
    color: var(--text);
    margin-bottom: 2px;
  }

  .card-status {
    font-size: 12px;
    color: var(--green);
    font-weight: 500;
  }

  .card-body {
    padding: 0 16px 16px;
    border-top: 1px solid var(--border);
    animation: slideUp 0.3s ease-out;
  }

  .body-section {
    margin-top: 16px;
  }

  .section-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 600;
    color: var(--text-dim);
    margin-bottom: 8px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .body-section p {
    font-size: 14px;
    line-height: 1.7;
    color: var(--text);
  }

  .example-box {
    padding: 12px;
    background: rgba(255, 184, 0, 0.06);
    border: 1px solid rgba(255, 184, 0, 0.15);
    border-radius: 8px;
    font-size: 13px;
    line-height: 1.6;
    color: var(--amber);
    font-style: italic;
  }

  .flag-list {
    list-style: none;
    padding: 0;
  }

  .flag-item {
    position: relative;
    padding: 8px 0 8px 20px;
    font-size: 14px;
    color: var(--text);
    border-bottom: 1px solid rgba(255, 23, 68, 0.06);
  }

  .flag-item::before {
    content: '⚠️';
    position: absolute;
    left: 0;
    font-size: 12px;
  }

  .flag-item:last-child {
    border-bottom: none;
  }

  .protect-list {
    list-style: none;
    padding: 0;
  }

  .protect-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    padding: 8px 0;
    font-size: 14px;
    color: var(--text);
    border-bottom: 1px solid rgba(0, 255, 136, 0.06);
  }

  .protect-item:last-child {
    border-bottom: none;
  }

  .protect-item svg {
    flex-shrink: 0;
    margin-top: 4px;
  }

  .quiz-section {
    padding: 16px;
    background: rgba(124, 111, 255, 0.05);
    border: 1px solid rgba(124, 111, 255, 0.15);
    border-radius: 10px;
  }

  .quiz-question {
    font-weight: 500;
    margin-bottom: 12px;
  }

  .quiz-options {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .quiz-option {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 12px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    color: var(--text);
    font-size: 13px;
    text-align: left;
    transition: all 0.2s ease;
  }

  .quiz-option:hover:not(:disabled) {
    background: rgba(0, 255, 136, 0.08);
    border-color: var(--green);
  }

  .quiz-option.correct {
    background: rgba(0, 255, 136, 0.15);
    border-color: var(--green);
    color: var(--green);
  }

  .quiz-option.wrong {
    background: rgba(255, 23, 68, 0.15);
    border-color: var(--red);
    color: var(--red);
  }

  .quiz-option:disabled {
    opacity: 0.7;
    cursor: default;
  }

  .option-letter {
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.06);
    border-radius: 6px;
    font-size: 12px;
    font-weight: 700;
    flex-shrink: 0;
  }

  .quiz-result {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 12px;
    padding: 10px 14px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 500;
    animation: fadeIn 0.3s ease-out;
  }

  .result-correct {
    background: rgba(0, 255, 136, 0.1);
    color: var(--green);
  }

  .result-wrong {
    background: rgba(255, 23, 68, 0.1);
    color: var(--red);
  }
</style>
