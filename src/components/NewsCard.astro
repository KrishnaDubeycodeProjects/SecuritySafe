---
import type { NewsItem } from '../utils/types';

export interface Props {
  item: NewsItem;
}

const { item } = Astro.props;

const typeConfig = {
  alert: { label: 'Alert', color: 'var(--red)' },
  advisory: { label: 'Advisory', color: 'var(--amber)' },
  tip: { label: 'Tip', color: 'var(--green)' },
  trend: { label: 'Trend', color: 'var(--purple)' },
  report: { label: 'Report', color: 'var(--text-dim)' },
};

const severityConfig = {
  CRITICAL: { label: 'CRITICAL', color: 'var(--red)' },
  HIGH: { label: 'HIGH', color: 'var(--amber)' },
  MEDIUM: { label: 'MEDIUM', color: 'var(--purple)' },
  LOW: { label: 'LOW', color: 'var(--green)' },
};
---

<div class="news-card" data-type={item.type}>
  {item.severity === 'CRITICAL' && (
    <div class="breaking-banner">BREAKING ALERT</div>
  )}

  <div class="news-header">
    <span class="news-type-badge" style="--badge-color: {typeConfig[item.type].color}">
      {typeConfig[item.type].label}
    </span>
    {item.severity && (
      <span class="news-severity" style="--sev-color: {severityConfig[item.severity]?.color || 'var(--text-dim)'}">
        {item.severity}
      </span>
    )}
  </div>

  <h3 class="news-title">{item.title}</h3>
  <p class="news-summary">{item.summary}</p>

  <div class="news-footer">
    <div class="news-meta">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
      </svg>
      <span>{item.date}</span>
    </div>
    <div class="news-meta">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
      </svg>
      <span>{item.source}</span>
    </div>
  </div>

  {item.involvedStates && item.involvedStates.length > 0 && (
    <div class="news-tags">
      {item.involvedStates.map((state) => (
        <span class="news-tag">{state}</span>
      ))}
    </div>
  )}
</div>

<style is:global>
  .news-card {
    padding: 20px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 14px;
    margin-bottom: 12px;
    position: relative;
    overflow: hidden;
    transition: all 0.2s ease;
  }

  .news-card[data-type="alert"] {
    border-left: 3px solid var(--red);
  }

  .news-card[data-type="advisory"] {
    border-left: 3px solid var(--amber);
  }

  .news-card[data-type="tip"] {
    border-left: 3px solid var(--green);
  }

  .news-card[data-type="trend"] {
    border-left: 3px solid var(--purple);
  }

  .breaking-banner {
    position: absolute;
    top: 12px;
    right: -28px;
    background: var(--red);
    color: #fff;
    font-size: 9px;
    font-weight: 700;
    padding: 3px 32px;
    transform: rotate(45deg);
    letter-spacing: 1px;
  }

  .news-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
  }

  .news-type-badge {
    font-size: 10px;
    font-weight: 600;
    padding: 3px 8px;
    border-radius: 5px;
    color: var(--badge-color);
    background: color-mix(in srgb, var(--badge-color) 15%, transparent);
    border: 1px solid color-mix(in srgb, var(--badge-color) 30%, transparent);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .news-severity {
    font-size: 9px;
    font-weight: 700;
    color: var(--sev-color);
    letter-spacing: 0.5px;
  }

  .news-title {
    font-size: 15px;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 8px;
    line-height: 1.4;
  }

  .news-summary {
    font-size: 13px;
    color: var(--text-dim);
    line-height: 1.6;
    margin-bottom: 14px;
  }

  .news-footer {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 12px;
    flex-wrap: wrap;
  }

  .news-meta {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 11px;
    color: var(--text-dim);
    opacity: 0.7;
  }

  .news-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .news-tag {
    font-size: 10px;
    padding: 3px 8px;
    background: rgba(0, 255, 136, 0.06);
    border: 1px solid rgba(0, 255, 136, 0.12);
    border-radius: 5px;
    color: var(--text-dim);
  }
</style>
