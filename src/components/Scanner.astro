---

---

<section id="scanner" class="scanner-section">
  <div class="container">
    <h2 class="scanner-title">Universal Scanner</h2>
    <p class="scanner-desc">Paste any suspicious message below and check instantly</p>
    <div class="input-wrapper">
      <textarea
        id="scan-input"
        class="scan-input"
        rows="4"
        placeholder='Paste here:

• WhatsApp Message
• SMS
• Email
• Link
• Phone Number

Example: "Your KYC has expired. Click here..."'
      ></textarea>
      <div class="input-hint">Supports SMS, WhatsApp, Email, Links & Phone Numbers</div>
    </div>
    <button id="scan-btn" class="analyze-btn" onclick="handleScan()">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"/>
        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
      Analyze
    </button>
    <div id="loading" class="loading hidden">
      <div class="spinner"></div>
      <span>Scanning for threats...</span>
    </div>
    <div id="result-container" class="hidden"></div>
  </div>
</section>

<script>
  import { scanInput } from '../utils/scanner';

  window.handleScan = async function() {
    const input = document.getElementById('scan-input');
    const loading = document.getElementById('loading');
    const resultContainer = document.getElementById('result-container');
    const btn = document.getElementById('scan-btn');

    const text = input.value.trim();
    if (!text) {
      input.focus();
      input.style.borderColor = 'var(--red)';
      setTimeout(() => input.style.borderColor = '', 1000);
      return;
    }

    btn.disabled = true;
    loading.classList.remove('hidden');
    resultContainer.classList.add('hidden');
    resultContainer.innerHTML = '';

    try {
      const result = await scanInput(text);
      const scoreColor = result.score <= 3 ? 'var(--error)' : result.score <= 6 ? 'var(--warning)' : 'var(--success)';
      const verdictIcon = result.score <= 3 ? 'danger' : result.score <= 6 ? 'warning' : 'safe';

      resultContainer.innerHTML = `
        <div class="result-card animate-slide-up" style="--accent: ${scoreColor}">
          <div class="result-header">
            <div class="result-type-badge">
              ${getTypeIcon(result.type)}
              <span>${result.type.toUpperCase()}</span>
            </div>
            <div class="result-threat">${result.threatType}</div>
          </div>

          <div class="score-section">
            <div class="score-ring" style="
              --score: ${result.score};
              --color: ${scoreColor};
              --glow: ${glowClass};
            ">
              <svg class="ring-svg" width="100" height="100" viewBox="0 0 100 100">
                <circle class="ring-bg" cx="50" cy="50" r="42" fill="none" stroke="#1a1a2e" stroke-width="6"/>
                <circle class="ring-fill" cx="50" cy="50" r="42" fill="none" stroke="${scoreColor}" stroke-width="6"
                  stroke-linecap="round" stroke-dasharray="${2 * Math.PI * 42}"
                  stroke-dashoffset="${2 * Math.PI * 42 * (1 - result.score / 10)}"
                  transform="rotate(-90, 50, 50)"
                  style="transition: stroke-dashoffset 1s ease;"
                />
              </svg>
              <div class="score-value" style="color: ${scoreColor}">${result.score}<span class="score-total">/10</span></div>
            </div>
            <div class="verdict-badge" style="--badge-color: ${scoreColor}; --badge-glow: ${glowClass}">
              ${getVerdictIcon(result.verdict)}
              <span>${result.verdict}</span>
            </div>
          </div>

          <div class="result-reason">
            <div class="reason-label">Analysis</div>
            <p>${result.reason}</p>
          </div>

          <div class="action-steps">
            <div class="steps-label">Action Steps</div>
            ${result.actionSteps.map((step, i) => `
              <div class="step-item">
                <div class="step-check" style="background: ${scoreColor}20; border-color: ${scoreColor}; color: ${scoreColor}">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"/>
                  </svg>
                </div>
                <span>${step}</span>
              </div>
            `).join('')}
          </div>

          <div class="result-footer">
            <button class="scan-again-btn" onclick="resetScan()">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="23 4 23 10 17 10"/>
                <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/>
              </svg>
              Scan Something Else
            </button>
          </div>
        </div>
      `;
      resultContainer.classList.remove('hidden');
    } catch (err) {
      resultContainer.innerHTML = `
        <div class="error-card">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--red)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <line x1="15" y1="9" x2="9" y2="15"/>
            <line x1="9" y1="9" x2="15" y2="15"/>
          </svg>
          <p>Analysis failed. Please try again.</p>
        </div>
      `;
      resultContainer.classList.remove('hidden');
    } finally {
      btn.disabled = false;
      loading.classList.add('hidden');
    }
  };

  window.resetScan = function() {
    const input = document.getElementById('scan-input');
    const resultContainer = document.getElementById('result-container');
    input.value = '';
    resultContainer.innerHTML = '';
    resultContainer.classList.add('hidden');
    input.focus();
  };

  function getTypeIcon(type) {
    const icons = {
      url: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>',
      sms: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>',
      whatsapp: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>',
      email: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>',
      phone: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>',
      unknown: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>'
    };
    return icons[type] || icons.unknown;
  }

  function getVerdictIcon(verdict) {
    if (verdict === 'DANGEROUS') {
      return '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>';
    } else if (verdict === 'SUSPICIOUS') {
      return '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>';
    }
    return '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>';
  }
</script>

<style is:global>
  .scanner-section {
    padding: var(--space-4xl) 0;
    scroll-margin-top: -20px;
    max-width: 640px;
    margin: 0 auto;
  }

  .scanner-title {
    font-size: 1.75rem;
    font-weight: 600;
    letter-spacing: -0.025em;
    text-align: center;
    color: var(--ink);
    margin-bottom: var(--space-xxs);
  }

  .scanner-desc {
    font-size: 0.875rem;
    color: var(--body);
    text-align: center;
    margin-bottom: var(--space-xl);
  }

  .input-wrapper {
    position: relative;
  }

  .scan-input {
    width: 100%;
    padding: var(--space-md);
    background: var(--canvas);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-md);
    color: var(--ink);
    font-size: 0.875rem;
    line-height: 1.6;
    resize: vertical;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
    min-height: 120px;
    box-shadow: var(--shadow-level-1);
  }

  .scan-input:focus {
    border-color: var(--link);
    box-shadow: 0 0 0 3px var(--link-bg-soft);
  }

  .scan-input::placeholder {
    color: var(--mute);
    font-size: 0.8125rem;
    line-height: 1.8;
  }

  .input-hint {
    font-size: 0.6875rem;
    color: var(--mute);
    margin-top: var(--space-xs);
  }

  .analyze-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs);
    width: 100%;
    padding: 14px;
    margin-top: var(--space-md);
    background: var(--ink);
    color: var(--on-ink);
    font-weight: 500;
    font-size: 0.9375rem;
    border-radius: var(--radius-pill);
    transition: var(--transition);
    letter-spacing: -0.01em;
  }

  .analyze-btn:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  .analyze-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
    transform: none;
  }

  .loading {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs);
    padding: var(--space-lg);
    color: var(--body);
    font-size: 0.875rem;
  }

  .spinner {
    width: 20px;
    height: 20px;
    border: 2px solid var(--hairline);
    border-top-color: var(--link);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  .hidden {
    display: none !important;
  }

  .result-card {
    margin-top: var(--space-lg);
    padding: var(--space-lg);
    background: var(--canvas);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-level-3);
    animation: slideUp 0.5s ease-out;
  }

  .result-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-lg);
  }

  .result-type-badge {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    background: var(--canvas-soft-2);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-full);
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--body);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .result-threat {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ink);
  }

  .score-section {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-lg);
    margin-bottom: var(--space-lg);
    flex-wrap: wrap;
  }

  .score-ring {
    position: relative;
    width: 100px;
    height: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ring-svg {
    position: absolute;
  }

  .ring-bg {
    stroke: var(--hairline);
  }

  .ring-fill {
    transition: stroke-dashoffset 1.5s ease;
  }

  .score-value {
    font-size: 2rem;
    font-weight: 600;
    font-family: var(--font-display);
    letter-spacing: -0.03em;
    z-index: 1;
  }

  .score-total {
    font-size: 0.875rem;
    font-weight: 400;
    opacity: 0.4;
  }

  .verdict-badge {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    border-radius: var(--radius-full);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    background: color-mix(in srgb, var(--badge-color) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--badge-color) 30%, transparent);
    color: var(--badge-color);
    animation: fadeIn 0.5s ease-out 0.3s both;
  }

  .result-reason {
    margin-bottom: var(--space-lg);
    padding: var(--space-md);
    background: var(--canvas-soft);
    border-radius: var(--radius-md);
  }

  .reason-label, .steps-label {
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--mute);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-xs);
    font-family: var(--font-mono);
  }

  .result-reason p {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--ink);
  }

  .action-steps {
    margin-bottom: var(--space-lg);
  }

  .step-item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 10px 0;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--ink);
    border-bottom: 1px solid var(--hairline);
  }

  .step-item:last-child {
    border-bottom: none;
  }

  .step-check {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 1.5px solid;
    margin-top: 1px;
  }

  .result-footer {
    text-align: center;
  }

  .scan-again-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 18px;
    background: transparent;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-pill);
    color: var(--body);
    font-size: 0.8125rem;
    font-weight: 500;
    transition: var(--transition);
  }

  .scan-again-btn:hover {
    border-color: var(--link);
    color: var(--link);
  }

  .error-card {
    text-align: center;
    padding: var(--space-lg);
    color: var(--error);
  }

  .error-card p {
    margin-top: var(--space-xs);
    font-size: 0.875rem;
  }

  @media (min-width: 768px) {
    .scanner-section {
      padding: var(--space-5xl) 0;
    }

    .scanner-title {
      font-size: 2rem;
    }

    .scan-input {
      padding: var(--space-lg);
      font-size: 0.9375rem;
    }

    .analyze-btn {
      padding: 16px;
      font-size: 1rem;
    }
  }
</style>
