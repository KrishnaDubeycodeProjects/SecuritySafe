---
export interface Props {
  currentPage?: string;
}

const { currentPage = 'home' } = Astro.props;

// Replaced 'More' with specific tabs to give users direct access
const navItems = [
  { id: 'scan', label: 'Scan', path: '/' },
  { id: 'learn', label: 'Learn', path: '/learn' },
  { id: 'emergency', label: 'Emergency', path: '/emergency' },
  { id: 'community', label: 'Community', path: '/community' },
  { id: 'blogs', label: 'Blogs', path: '/blogs' },
  { id: 'safe-saathi', label: 'Safe-saathi', path: '/safe-saathi' },
  { id: 'feedback', label: 'Feedback', path: '/feedback' },
];
---

<nav class="navbar">
  <div class="nav-inner">
    <a href="/" class="nav-logo">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--ink)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        <path d="M9 12l2 2 4-4" stroke-width="2"/>
      </svg>
      <span class="nav-logo-text">SAFE</span>
    </a>

    <!-- Desktop Links: all items always rendered; More dropdown hidden on 1200px+ via CSS -->
    <div class="nav-links" id="navLinks">
      {
        navItems.map((item) => (
          <a
            href={item.path}
            class:list={{ 'nav-link': true, 'nav-link--overflow': navItems.indexOf(item) >= 4, active: currentPage === item.id }}
          >
            {item.label}
          </a>
        ))
      }
      <!-- More dropdown for tablet (768-1199px): shows items 5+ that are hidden via CSS at tablet -->
      <div class="nav-more" id="navMore">
        <button class="nav-more-btn" id="navMoreBtn" aria-haspopup="true" aria-expanded="false">
          More
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="nav-dropdown" id="navDropdown">
          {
            navItems.slice(4).map((item) => (
              <a
                href={item.path}
                class:list={{ 'nav-dropdown-link': true, active: currentPage === item.id }}
              >
                {item.label}
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <div class="nav-actions">
     
      
      <!-- Mobile Menu Button -->
      <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="Open menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--ink)" stroke-width="2" stroke-linecap="round">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
    </div>
  </div>
</nav>

<!-- Mobile Sidebar Overlay -->
<div class="mobile-nav-overlay" id="mobileNavOverlay">
  <div class="mobile-nav-sidebar" id="mobileNavSidebar">
    <div class="mobile-nav-header">
      <a href="/" class="nav-logo">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--ink)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          <path d="M9 12l2 2 4-4" stroke-width="2"/>
        </svg>
        <span class="nav-logo-text">SAFE</span>
      </a>
      <button class="nav-close" id="navClose" aria-label="Close menu">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--ink)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>
    <ul class="mobile-nav-links">
      {
        navItems.map((item) => (
          <li>
            <a 
              href={item.path} 
              class:list={{ 'mobile-link': true, active: currentPage === item.id }}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="mobile-nav-footer">
       <p class="footer-text">Your digital safety shield.</p>
    </div>
  </div>
</div>

<script>
  (function() {
    // Mobile Menu Toggle
    const mobileMenuBtn = document.getElementById('mobileMenuBtn');
    const overlay = document.getElementById('mobileNavOverlay');
    const sidebar = document.getElementById('mobileNavSidebar');
    const closeBtn = document.getElementById('navClose');

    function openMenu() {
      if(overlay && sidebar) {
        overlay.classList.add('active');
        sidebar.classList.add('active');
        document.body.style.overflow = 'hidden';
      }
    }
    function closeMenu() {
      if(overlay && sidebar) {
        overlay.classList.remove('active');
        sidebar.classList.remove('active');
        document.body.style.overflow = '';
      }
    }
    if(mobileMenuBtn) mobileMenuBtn.addEventListener('click', openMenu);
    if(closeBtn) closeBtn.addEventListener('click', closeMenu);
    if(overlay) overlay.addEventListener('click', (e) => {
      if (e.target === overlay) closeMenu();
    });

    // More dropdown toggle
    const moreBtn = document.getElementById('navMoreBtn');
    const dropdown = document.getElementById('navDropdown');
    if (moreBtn && dropdown) {
      moreBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const open = dropdown.classList.toggle('open');
        moreBtn.setAttribute('aria-expanded', String(open));
      });
      document.addEventListener('click', () => {
        dropdown.classList.remove('open');
        moreBtn.setAttribute('aria-expanded', 'false');
      });
    }
  })();
</script>

<style is:global>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: var(--nav-height, 64px);
    background: rgba(255, 255, 255, 0.8);
    border-bottom: 1px solid var(--hairline, #E5E5E5);
    z-index: 100;
    transition: background 0.3s ease, border-color 0.3s ease, height 0.3s ease;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  

  .nav-inner {
    max-width: var(--max-width, 1200px);
    margin: 0 auto;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 24px;
    transition: padding 0.3s ease, max-width 0.3s ease;
  }

  .nav-logo {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    flex-shrink: 0;
  }

  .nav-logo svg {
    width: 24px;
    height: 24px;
    transition: all 0.3s ease;
  }

  .nav-logo-text {
    font-size: 18px;
    font-weight: 700;
    color: var(--ink, #0A0A0A);
    letter-spacing: -0.03em;
    transition: font-size 0.3s ease;
  }

  /* Desktop Links */
  .nav-links {
    display: none;
    gap: 4px;
    align-items: center;
    transition: gap 0.3s ease;
  }

  .nav-link {
    padding: 8px 16px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 500;
    color: var(--body, #525252);
    text-decoration: none;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .nav-link:hover {
    color: var(--ink, #0A0A0A);
    background: var(--canvas-soft, #F7F7F7);
  }

  .nav-link.active {
    color: var(--ink, #0A0A0A);
    background: var(--canvas-soft, #F7F7F7);
    font-weight: 600;
  }

  /* More dropdown (tablet) */
  .nav-more { position: relative; }

  .nav-more-btn {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 8px 14px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 500;
    color: var(--body, #525252);
    background: none;
    border: none;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
  }
  .nav-more-btn:hover { color: var(--ink, #0A0A0A); background: var(--canvas-soft, #F7F7F7); }

  .nav-dropdown {
    display: none;
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    background: #fff;
    border: 1px solid var(--hairline, #E5E5E5);
    border-radius: 12px;
    box-shadow: 0 8px 32px rgba(0,0,0,.12);
    min-width: 160px;
    flex-direction: column;
    padding: 6px;
    z-index: 200;
  }
  .nav-dropdown.open { display: flex; }

  .nav-dropdown-link {
    padding: 9px 14px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
    color: var(--body, #525252);
    text-decoration: none;
    transition: all 0.15s ease;
    white-space: nowrap;
  }
  .nav-dropdown-link:hover,
  .nav-dropdown-link.active { background: var(--canvas-soft, #F7F7F7); color: var(--ink, #0A0A0A); }


  .nav-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    transition: gap 0.3s ease;
  }



  

  /* Mobile Menu Button */
  .mobile-menu-btn {
    display: flex;
    background: none;
    border: 1px solid var(--hairline, #E5E5E5);
    border-radius: 8px;
    padding: 8px;
    cursor: pointer;
    color: var(--ink, #0A0A0A);
    transition: all 0.2s ease;
  }

  .mobile-menu-btn:hover {
    background: var(--canvas-soft, #F7F7F7);
  }



  /* Mobile Sidebar Overlay */
  .mobile-nav-overlay {
    position: fixed;
    inset: 0;
    background: rgba(10, 10, 10, 0.4);
    z-index: 1000;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
    backdrop-filter: blur(4px);
  }

  .mobile-nav-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  .mobile-nav-sidebar {
    position: fixed;
    top: 0;
    left: 0;
    width: 85%;
    max-width: 320px;
    height: 100vh;
    height: 100dvh; /* Full length on mobile */
    background: var(--canvas, #FFFFFF);
    z-index: 1001;
    transform: translateX(-100%);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
    box-shadow: 4px 0 24px rgba(0,0,0,0.1);
  }


  .mobile-nav-sidebar.active {
    transform: translateX(0);
  }

  .mobile-nav-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 24px;
    border-bottom: 1px solid var(--hairline, #E5E5E5);
  }


  .nav-close {
    background: none;
    border: none;
    color: var(--ink, #0A0A0A);
    cursor: pointer;
    padding: 8px;
    border-radius: 8px;
    transition: background 0.2s ease;
    display: flex;
  }

  .nav-close:hover {
    background: var(--canvas-soft, #F7F7F7);
  }


  .mobile-nav-links {
    list-style: none;
    padding: 16px;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1;
    overflow-y: auto;
  }

  .mobile-link {
    display: flex;
    align-items: center;
    padding: 16px;
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--body, #525252);
    text-decoration: none;
    border-radius: 12px;
    transition: all 0.2s ease;
  }

  .mobile-link:hover {
    background: var(--canvas-soft, #F7F7F7);
    color: var(--ink, #0A0A0A);
    transform: translateX(4px);
  }

  .mobile-link.active {
    background: var(--canvas-soft, #F7F7F7);
    color: var(--ink, #0A0A0A);
  }


  .mobile-nav-footer {
    padding: 24px;
    border-top: 1px solid var(--hairline, #E5E5E5);
  }

 

  .footer-text {
    font-size: 0.875rem;
    color: var(--mute, #A3A3A3);
    margin: 0;
  }

  /* Tablet / Small Desktop — show primary 4 links + More dropdown */
  @media (min-width: 768px) {
    .nav-links {
      display: flex;
    }
    /* Hide overflow items (5-7) at tablet — they appear in More dropdown */
    .nav-link--overflow {
      display: none;
    }
    .nav-link {
      padding: 7px 11px;
      font-size: 13px;
    }
    .mobile-menu-btn {
      display: none;
    }
    .nav-inner {
      padding: 0 24px;
    }
  }

  /* Large Laptop / Desktop — show all links, hide More dropdown */
  @media (min-width: 1200px) {
    .navbar      { height: var(--nav-height, 80px); }
    .nav-inner   { max-width: var(--max-width, 1400px); padding: 0 64px; }
    .nav-logo svg   { width: 32px; height: 32px; }
    .nav-logo-text  { font-size: 24px; }
    .nav-links      { gap: 8px; }
    .nav-link       { font-size: 15px; padding: 9px 16px; }
    /* Show all overflow items inline on large desktop */
    .nav-link--overflow { display: flex; }
    .nav-actions    { gap: 20px; }
    /* Hide More dropdown entirely on large screens */
    .nav-more       { display: none; }
  }

  @media (max-width: 767px) {
    .nav-links {
      display: none; /* Hidden on mobile, shown in sidebar instead */
    }
  }
</style>