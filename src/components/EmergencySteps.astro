<section class="emergency-steps">
  <div class="emergency-header">
    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--red)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
      <line x1="12" y1="9" x2="12" y2="13"/>
      <line x1="12" y1="17" x2="12.01" y2="17"/>
    </svg>
    <h2>Fraud Already Happened?</h2>
    <p>Don't panic. Follow these steps immediately.</p>
  </div>

  <div class="step-card step-1">
    <div class="step-number">1</div>
    <div class="step-content">
      <h3>Call 1930</h3>
      <p>India's national cyber crime helpline. Available 24/7.</p>
      <a href="tel:1930" class="step-action urgent">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
        Call 1930 Now
      </a>
    </div>
  </div>

  <div class="step-card step-2">
    <div class="step-number">2</div>
    <div class="step-content">
      <h3>Report on Cyber Crime Portal</h3>
      <p>File an official complaint at the government portal.</p>
      <a href="https://cybercrime.gov.in" target="_blank" rel="noopener noreferrer" class="step-action">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
          <polyline points="15 3 21 3 21 9"/>
          <line x1="10" y1="14" x2="21" y2="3"/>
        </svg>
        Visit cybercrime.gov.in
      </a>
    </div>
  </div>

  <div class="step-card step-3">
    <div class="step-number">3</div>
    <div class="step-content">
      <h3>Contact Your Bank</h3>
      <p>Immediately inform your bank to block cards and freeze accounts if money is stolen.</p>
      <div class="bank-tips">
        <p class="tip">Call your bank's 24/7 customer care</p>
        <p class="tip">Request to block debit/credit cards</p>
        <p class="tip">Check for unauthorized transactions</p>
        <p class="tip">File a dispute for fraudulent charges</p>
      </div>
    </div>
  </div>

  <div class="step-card step-4">
    <div class="step-number">4</div>
    <div class="step-content">
      <h3>Save All Evidence</h3>
      <p>Preserve every piece of evidence. This will help in investigation and recovery.</p>
      <div class="evidence-grid">
        <div class="evidence-item">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="2">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
          </svg>
          <span>Screenshots</span>
        </div>
        <div class="evidence-item">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="2">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
            <polyline points="14 2 14 8 20 8"/>
          </svg>
          <span>Messages</span>
        </div>
        <div class="evidence-item">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="2">
            <rect x="1" y="4" width="22" height="16" rx="2" ry="2"/>
            <line x1="1" y1="10" x2="23" y2="10"/>
          </svg>
          <span>Bank Statements</span>
        </div>
        <div class="evidence-item">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <polyline points="12 6 12 12 16 14"/>
          </svg>
          <span>Timeline</span>
        </div>
      </div>
    </div>
  </div>

  <div class="step-card step-5">
    <div class="step-number">5</div>
    <div class="step-content">
      <h3>File Police Complaint</h3>
      <p>Visit your nearest police station with all evidence. Under Bharatiya Nagarik Suraksha Sanhita (BNSS), cyber fraud is a cognizable offense.</p>
      <div class="police-info">
        <p>📋 Take these documents:</p>
        <ul>
          <li>All screenshots and messages</li>
          <li>Bank transaction statements</li>
          <li>Cyber crime portal complaint copy</li>
          <li>1930 complaint reference number</li>
        </ul>
      </div>
    </div>
  </div>

  <div class="emergency-footer">
    <p>Remember: Acting fast increases your chance of recovering lost money.</p>
  </div>
</section>

<style is:global>
  .emergency-steps {
    padding: 0 0 40px;
  }

  .emergency-header {
    text-align: center;
    padding: 32px 16px;
    margin-bottom: 8px;
  }

  .emergency-header h2 {
    font-size: 20px;
    color: var(--red);
    margin-top: 12px;
    margin-bottom: 8px;
  }

  .emergency-header p {
    font-size: 14px;
    color: var(--text-dim);
  }

  .step-card {
    display: flex;
    gap: 16px;
    padding: 20px;
    margin-bottom: 16px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 14px;
    transition: border-color 0.2s ease;
  }

  .step-card:hover {
    border-color: rgba(0, 255, 136, 0.3);
  }

  .step-number {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 23, 68, 0.1);
    border: 1px solid rgba(255, 23, 68, 0.3);
    border-radius: 50%;
    font-family: var(--font-heading);
    font-size: 16px;
    font-weight: 700;
    color: var(--red);
    flex-shrink: 0;
  }

  .step-content {
    flex: 1;
  }

  .step-content h3 {
    font-size: 16px;
    color: var(--text);
    margin-bottom: 6px;
  }

  .step-content > p {
    font-size: 13px;
    color: var(--text-dim);
    line-height: 1.5;
    margin-bottom: 12px;
  }

  .step-action {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border: 1px solid var(--border);
    border-radius: 10px;
    color: var(--text);
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .step-action:hover {
    border-color: var(--green);
    color: var(--green);
  }

  .step-action.urgent {
    background: var(--red);
    border-color: var(--red);
    color: #fff;
    box-shadow: 0 0 20px rgba(255, 23, 68, 0.3);
    animation: pulse-red 2s ease-in-out infinite;
  }

  .step-action.urgent:hover {
    box-shadow: 0 0 30px rgba(255, 23, 68, 0.5);
    transform: translateY(-1px);
  }

  .bank-tips {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .tip {
    font-size: 13px !important;
    color: var(--text) !important;
    padding-left: 16px;
    position: relative;
  }

  .tip::before {
    content: '•';
    position: absolute;
    left: 4px;
    color: var(--green);
  }

  .evidence-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  .evidence-item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px;
    background: rgba(0, 255, 136, 0.04);
    border: 1px solid rgba(0, 255, 136, 0.1);
    border-radius: 8px;
    font-size: 13px;
    color: var(--text);
  }

  .police-info {
    padding: 12px;
    background: rgba(255, 184, 0, 0.06);
    border: 1px solid rgba(255, 184, 0, 0.15);
    border-radius: 8px;
  }

  .police-info ul {
    list-style: none;
    padding: 0;
    margin-top: 8px;
  }

  .police-info li {
    padding: 4px 0 4px 20px;
    font-size: 13px;
    color: var(--text);
    position: relative;
  }

  .police-info li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--green);
  }

  .emergency-footer {
    text-align: center;
    padding: 24px 16px;
    font-size: 14px;
    color: var(--text-dim);
    font-style: italic;
  }

  @media (max-width: 360px) {
    .evidence-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
