---
import type { SafeScoreData } from '../utils/types';

export interface Props {
  score: SafeScoreData;
}

const { score } = Astro.props;

const categoryLabels: Record<string, string> = {
  passwordStrength: 'Password Strength',
  fraudAwareness: 'Fraud Awareness',
  threatReports: 'Threat Reports',
  securitySettings: 'Security Settings',
  learningCompletion: 'Learning Completion',
  accountSecurity: 'Account Security',
  riskExposure: 'Risk Exposure',
};
---

<section class="score-dashboard">
  <div class="score-hero" style="--rating-color: var(--green)">
    <div class="score-ring-large">
      <svg width="140" height="140" viewBox="0 0 140 140">
        <circle cx="70" cy="70" r="60" fill="none" stroke="#1a1a2e" stroke-width="8"/>
        <circle cx="70" cy="70" r="60" fill="none" stroke="var(--green)" stroke-width="8"
          stroke-linecap="round"
          stroke-dasharray="376.99"
          stroke-dashoffset={376.99 * (1 - score.overall / 10)}
          transform="rotate(-90, 70, 70)"
        />
      </svg>
      <div class="score-number">{score.overall}<span class="score-max">/10</span></div>
    </div>
    <div class="score-rating">{score.rating}</div>
    {score.previousMonth && (
      <div class="score-trend">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="2">
          <polyline points="18 15 12 9 6 15"/>
        </svg>
        <span>Up from {score.previousMonth}/10 last month</span>
      </div>
    )}
  </div>

  <div class="score-categories">
    <h3 class="section-title">Breakdown</h3>
    {Object.entries(score.categories).map(([key, val]) => (
      <div class="category-bar">
        <div class="category-header">
          <span class="category-name">{categoryLabels[key] || key}</span>
          <span class="category-value">{val}/10</span>
        </div>
        <div class="bar-track">
          <div class="bar-fill" style="width: {val * 10}%" data-level={val >= 7 ? 'good' : val >= 4 ? 'fair' : 'poor'}></div>
        </div>
      </div>
    ))}
  </div>

  <div class="score-suggestions">
    <h3 class="section-title">Improvement Suggestions</h3>
    <div class="suggestions-list">
      {score.suggestions.map((suggestion) => (
        <div class="suggestion-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <line x1="12" y1="16" x2="12" y2="12"/>
            <line x1="12" y1="8" x2="12.01" y2="8"/>
          </svg>
          <span>{suggestion}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style is:global>
  .score-dashboard {
    padding: 0;
  }

  .score-hero {
    text-align: center;
    padding: 32px 0;
  }

  .score-ring-large {
    position: relative;
    width: 140px;
    height: 140px;
    margin: 0 auto 16px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .score-ring-large svg {
    position: absolute;
  }

  .score-number {
    font-size: 42px;
    font-weight: 800;
    font-family: var(--font-heading);
    color: var(--green);
    z-index: 1;
  }

  .score-max {
    font-size: 16px;
    font-weight: 400;
    opacity: 0.4;
    vertical-align: super;
  }

  .score-rating {
    font-size: 14px;
    font-weight: 700;
    color: var(--green);
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .score-trend {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    font-size: 13px;
    color: var(--green);
    opacity: 0.8;
  }

  .section-title {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 16px;
  }

  .score-categories {
    margin-bottom: 32px;
  }

  .category-bar {
    margin-bottom: 16px;
  }

  .category-header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 6px;
  }

  .category-name {
    font-size: 13px;
    color: var(--text);
  }

  .category-value {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-dim);
  }

  .bar-track {
    height: 6px;
    background: rgba(255, 255, 255, 0.06);
    border-radius: 3px;
    overflow: hidden;
  }

  .bar-fill {
    height: 100%;
    border-radius: 3px;
    transition: width 1s ease;
  }

  .bar-fill[data-level="good"] { background: var(--green); }
  .bar-fill[data-level="fair"] { background: var(--amber); }
  .bar-fill[data-level="poor"] { background: var(--red); }

  .suggestions-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .suggestion-item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 14px;
    background: rgba(0, 255, 136, 0.03);
    border: 1px solid rgba(0, 255, 136, 0.08);
    border-radius: 10px;
    font-size: 13px;
    line-height: 1.5;
    color: var(--text);
  }

  .suggestion-item svg {
    flex-shrink: 0;
    margin-top: 2px;
  }
</style>
